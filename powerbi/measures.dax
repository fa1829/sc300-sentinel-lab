// DAX measures for the identity sign-in dashboard
// Table: SignIns (from SigninLogs via the Log Analytics M query)

Total Sign-ins =
COUNTROWS ( SignIns )

Failed Sign-ins =
CALCULATE ( COUNTROWS ( SignIns ), KEEPFILTERS ( SignIns[Outcome] <> "Success" ) )
// KEEPFILTERS matters: without it, CALCULATE replaces the Outcome filter coming
// from a visual or slicer, so every Outcome slice showed the same total (bug found
// in a pie chart where "Success" showed 33 failed sign-ins).

Failure Rate =
DIVIDE ( [Failed Sign-ins], [Total Sign-ins] )
// Format as Percentage in Measure tools.

Accounts Targeted =
CALCULATE (
    DISTINCTCOUNT ( SignIns[UserPrincipalName] ),
    KEEPFILTERS ( SignIns[Outcome] = "Bad password" )
)

// Calculated column (not a measure): sign-in time rounded down to the hour, UTC.
// Requires TimeGenerated to be of type Date/Time.
Hour =
DATE ( YEAR ( SignIns[TimeGenerated] ), MONTH ( SignIns[TimeGenerated] ), DAY ( SignIns[TimeGenerated] ) )
    + TIME ( HOUR ( SignIns[TimeGenerated] ), 0, 0 )

// ---- Incidents page (table: Incidents, from SecurityIncident) ----

Total Incidents =
COUNTROWS ( Incidents )

Open Incidents =
CALCULATE ( COUNTROWS ( Incidents ), KEEPFILTERS ( Incidents[Status] <> "Closed" ) )

High Severity Incidents =
CALCULATE ( COUNTROWS ( Incidents ), KEEPFILTERS ( Incidents[Severity] = "High" ) )

Mean Hours to Close =
AVERAGE ( Incidents[HoursToClose] )
// Only closed incidents have a value, so this is the mean over closed incidents.

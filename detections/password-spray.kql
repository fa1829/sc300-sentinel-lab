// Password spray: one IP, many accounts
// Table:    SigninLogs
// MITRE:    T1110 (Brute Force), tactic Credential Access
// Severity: Medium
// Status:   Deployed. Fired on lab test data 2026-11-17.
//
// One source IP with bad-password failures against 5 or more distinct
// accounts inside a 30-minute bin.
//
// Known gaps: attackers who rotate IPs stay under the per-IP threshold;
// shared egress IPs can cause false positives; fixed bins can split a spray.

SigninLogs
| where ResultType == "50126"            // invalid username or password
| summarize TargetedUsers = dcount(UserPrincipalName),
            Attempts      = count(),
            Users         = make_set(UserPrincipalName, 20)
    by IPAddress, bin(TimeGenerated, 30m)
| where TargetedUsers >= 5
